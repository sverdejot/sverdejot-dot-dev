---
import type { CollectionEntry } from 'astro:content';
import dayjs from 'dayjs';
import BaseLayout from './BaseLayout.astro';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags = [] } = entry.data;
const words = (entry.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 220));
---

<BaseLayout title={title} description={description} image={heroImage}>
  <article>
    <header class="post-head">
      <p class="kicker"><span class="ps">~/blog $</span> cat {entry.id}.md</p>
      <h1 class="title">{title}</h1>
      {description && <p class="desc">{description}</p>}
      <div class="post-meta">
        <time datetime={pubDate.toISOString()}>{dayjs(pubDate).format('MMM D, YYYY')}</time>
        <span>{minutes} min read</span>
        {updatedDate && <span>updated {dayjs(updatedDate).format('MMM D, YYYY')}</span>}
        {tags.map((tag) => <a href={`/blog/tag/${tag}/`}>#{tag}</a>)}
      </div>
    </header>
    <div class="post-body">
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>
