---
import BaseHead from '../components/BaseHead.astro';
import Masthead from '../components/Masthead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BoilFilter from '../components/avatar/BoilFilter.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../config';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description = SITE_DESCRIPTION, image } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_TITLE}` : `Samuel Verdejo · ${SITE_TITLE}`;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={fullTitle} description={description} image={image} />
  </head>
  <body>
    <BoilFilter />
    <div class="wrap">
      <Masthead />
      <main>
        <slot />
      </main>
      <SiteFooter />
    </div>
    <script>
      import '../scripts/avatar';
    </script>
  </body>
</html>
