---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Avatar from '../components/avatar/Avatar.astro';
import ProjectClip from '../components/ProjectClip.astro';
import PostList from '../components/PostList.astro';
import { featured } from '../data/projects';
import { LINKS } from '../config';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---

<BaseLayout>
  <section class="hero">
    <div class="stage">
      <div class="halftone"></div>
      <Avatar variant="hero" label="Animated doodle of Samuel. Click it." />
      <span class="poke" aria-hidden="true">
        poke me
        <svg viewBox="0 0 54 36"><path d="M4 32 C 18 28, 32 18, 46 5 M46 5 L 35 7 M46 5 L 44 16"></path></svg>
      </span>
      <span class="bubble" data-bubble aria-live="polite">hello, world</span>
    </div>

    <div>
      <p class="prompt"><span class="ps">~ $</span> <span class="cmd">whoami</span><span class="cursor"></span></p>
      <h1 class="name"><span class="a">Samuel</span><span class="b">Verdejo</span></h1>
      <p class="lede">
        <b>Senior Software Engineer.</b> I build things to see how they work, <span class="hl">break them</span> to see how
        they <i>really</i> work, and then write about it.
      </p>
      <div class="cta">
        <a class="btn primary" data-surprise href={LINKS.linkedin} target="_blank" rel="noopener">Let's connect</a>
        <a class="btn" href="/blog">Read the blog</a>
      </div>
    </div>
  </section>

  <section class="section" id="projects">
    <div class="sec-head">
      <h2 class="title">Projects</h2>
      <a class="more" href="/projects">all projects →</a>
    </div>
    <div class="clips">
      {featured.map((p) => <ProjectClip project={p} />)}
    </div>
  </section>

  <section class="section" id="blog">
    <div class="sec-head">
      <h2 class="title">From the <i>blog</i></h2>
      <a class="more" href="/blog">all posts →</a>
    </div>
    <PostList posts={posts} />
  </section>
</BaseLayout>
