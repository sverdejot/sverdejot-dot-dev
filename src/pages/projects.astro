---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectClip from '../components/ProjectClip.astro';
import { featured, archive } from '../data/projects';
import { LINKS } from '../config';
---

<BaseLayout title="Projects" description="Side projects by Samuel Verdejo: homelab, Go tools, keyboards and architecture experiments.">
  <header class="page-head">
    <p class="kicker"><span class="ps">~ $</span> ls ~/projects</p>
    <div class="sec-head">
      <h1 class="title title-xl">Projects</h1>
      <a class="more" href={LINKS.github} target="_blank" rel="noopener">github.com/sverdejot →</a>
    </div>
  </header>

  <div class="clips">
    {featured.map((p) => <ProjectClip project={p} />)}
  </div>

  <section class="section">
    <div class="sec-head">
      <h2 class="title">Older <i>experiments</i></h2>
    </div>
    <ul class="index">
      {
        archive.map((p) => (
          <li>
            <a href={p.url} target="_blank" rel="noopener">
              <span class="when">{p.since}</span>
              <div>
                <h3>
                  <span>{p.name}</span>
                </h3>
                <p>{p.description}</p>
              </div>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
