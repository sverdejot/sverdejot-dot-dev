---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return paginate(posts, { pageSize: 10 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<BaseLayout title="Blog" description="Notes on software architecture, DDD, microservices and the tools I use.">
  <header class="page-head">
    <p class="kicker"><span class="ps">~ $</span> ls ~/blog</p>
    <div class="sec-head">
      <h1 class="title title-xl">Blog</h1>
      <a class="more" href="/rss.xml">rss →</a>
    </div>
  </header>

  <PostList posts={page.data} />

  {
    (page.url.prev || page.url.next) && (
      <nav class="pager" aria-label="Pagination">
        {page.url.prev ? <a href={page.url.prev}>← newer posts</a> : <span />}
        {page.url.next ? <a href={page.url.next}>older posts →</a> : <span />}
      </nav>
    )
  }
</BaseLayout>
