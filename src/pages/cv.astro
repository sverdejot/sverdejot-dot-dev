---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LINKS } from '../config';

const experience = [
  {
    when: '2024 → now',
    role: 'Senior Software Engineer',
    company: 'Cabify',
    place: 'Madrid, Spain',
  },
  {
    when: '2023 → 2024',
    role: 'DevOps Engineer and Software Architect',
    company: 'Apex Group',
    place: 'Madrid, Spain',
    text: 'Helping 3 software engineering squads through the DevOps lifecycle, while refactoring legacy codebases into cloud-based, event-driven solutions to ensure testability, auditability, developer experience and the best time-to-market.',
  },
  {
    when: '2021 → 2023',
    role: 'Software Engineer and Cloud Analyst',
    company: 'Global Alquemy',
    place: 'Albacete, Spain',
    text: 'Full-stack engineering and main cloud analyst, with end-to-end contact with customers and stakeholders, requirements gathering and cost-optimized cloud solutions.',
  },
  {
    when: '2020 → 2021',
    role: 'Junior DevSecOps',
    company: 'OPINATOR',
    place: 'Madrid, Spain',
    text: 'Full-stack engineering, improving and implementing core features of a SaaS product deployed on AWS, with hundreds of thousands of end users.',
  },
];

const education = [
  { when: '2020 → 2021', role: 'MSc. in Computer Engineering', company: 'UCLM', place: 'Albacete, Spain', text: 'Only the thesis left.' },
  { when: '2016 → 2020', role: 'BSc. in Computer Engineering', company: 'UCLM', place: 'Albacete, Spain', text: 'Data Mining and Computer Science.' },
];

const certifications = [
  { name: 'AWS Certified Solutions Architect – Associate', code: 'SAA-C03' },
  { name: 'AWS Certified Cloud Practitioner', code: 'CLF-001' },
  { name: 'Azure Fundamentals', code: 'AZ-900' },
  { name: 'Professional Scrum Master I', code: 'PSM-I' },
];
---

<BaseLayout title="CV" description="Samuel Verdejo's résumé: experience, education and certifications.">
  <header class="page-head">
    <p class="kicker"><span class="ps">~ $</span> cat cv.md</p>
    <div class="sec-head">
      <h1 class="title title-xl">CV</h1>
      <a class="more" href={LINKS.linkedin} target="_blank" rel="noopener">linkedin →</a>
    </div>
    <p class="lede" style="max-width: 62ch">
      I'm <b>Samuel Verdejo de Toro</b>, a Senior Software Engineer based in Spain, currently at Cabify. I mostly work on
      the backend, with a soft spot for software design, architecture and agile delivery.
    </p>
  </header>

  <section class="cv-block">
    <div class="sec-head"><h2 class="title">Experience</h2></div>
    <ul class="timeline">
      {
        experience.map((e) => (
          <li>
            <span class="when">{e.when}</span>
            <div>
              <h3>{e.role}</h3>
              <div class="where">
                <b>{e.company}</b> · {e.place}
              </div>
              {e.text && <p>{e.text}</p>}
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="cv-block">
    <div class="sec-head"><h2 class="title">Education</h2></div>
    <ul class="timeline">
      {
        education.map((e) => (
          <li>
            <span class="when">{e.when}</span>
            <div>
              <h3>{e.role}</h3>
              <div class="where">
                <b>{e.company}</b> · {e.place}
              </div>
              {e.text && <p>{e.text}</p>}
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="cv-block">
    <div class="sec-head"><h2 class="title">Certifications</h2></div>
    <ul class="certs">
      {
        certifications.map((c) => (
          <li>
            <span>{c.name}</span>
            <code>{c.code}</code>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
