---
import type { CollectionEntry } from 'astro:content';
import dayjs from 'dayjs';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="kicker">No posts here yet. Check back soon.</p>
  ) : (
    <ul class="index">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`}>
            <time datetime={post.data.pubDate.toISOString()}>{dayjs(post.data.pubDate).format('YYYY-MM-DD')}</time>
            <div>
              <h3>
                <span>{post.data.title}</span>
                {post.data.badge && <span class="badge">{post.data.badge}</span>}
              </h3>
              {post.data.description && <p>{post.data.description}</p>}
            </div>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  )
}
